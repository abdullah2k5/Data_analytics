WITH employee_dup AS (
SELECT *, ROW_NUMBER() OVER (PARTITION BY first_name, last_name, email, department, salary, joining_date, phone_number, country, performance_score) as ROW_NUM FROM employee_messy2 )
SELECT * FROM employee_dup WHERE ROW_NUM > 1;

