SELECT first_name, TRIM(first_name) FROM employee_messy2;
UPDATE employee_messy2 SET first_name = TRIM(first_name);
SELECT last_name, TRIM(last_name) FROM employee_messy2;
UPDATE employee_messy2 SET last_name = TRIM(last_name);

SET SQL_SAFE_UPDATES = 0;

SELECT department FROM employee_messy2;
UPDATE employee_messy2 SET department = 'IT' WHERE department LIKE 'info%';
UPDATE employee_messy2 SET department = 'IT' WHERE department LIKE 'I.T';
UPDATE employee_messy2 SET department = 'HR' WHERE department LIKE 'Hum%';
UPDATE employee_messy2 SET department = 'HR' WHERE department LIKE 'Hr%';
UPDATE employee_messy2 SET department = 'Sales' WHERE department LIKE 'sales';
UPDATE employee_messy2 SET department = 'Finance' WHERE department LIKE 'FIN%';
UPDATE employee_messy2 SET department = 'Finance' WHERE department LIKE 'fin&';
UPDATE employee_messy2 SET department = NULL WHERE department LIKE '';

UPDATE employee_messy2 SET salary = ABS(salary) WHERE salary < 0;
UPDATE employee_messy2 SET salary = NULL WHERE salary = '';

UPDATE employee_messy2 SET email = LOWER(email);

SELECT phone_number FROM employee_messy2;
UPDATE employee_messy2 SET phone_number = REPLACE(phone_number, ' ' ,'');
UPDATE employee_messy2 SET phone_number = REPLACE(phone_number, '-' ,'');
SELECT * FROM employee_messy2 WHERE phone_number REGEXP '[A-Za-z]';
UPDATE employee_messy2 SET phone_number = NULL WHERE phone_number REGEXP '[A-Za-z]';
UPDATE employee_messy2 SET phone_number = NULL WHERE phone_number = '';
SELECT * FROM employee_messy2 WHERE LENGTH(phone_number) <>11;
UPDATE employee_messy2 SET phone_number = NULL WHERE LENGTH(phone_number) <>11;

