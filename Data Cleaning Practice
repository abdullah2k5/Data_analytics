CREATE TABLE employee_final AS
SELECT *
FROM (
    SELECT *,
    ROW_NUMBER() OVER (
        PARTITION BY employee_name,
        department,
        salary,
        joining_date,
        country
    ) AS row_num
    FROM employee_data2
) t
WHERE row_num = 1;
